# Copy to .env; export values into your shell or use compose.yaml.
MODEL_OPS_DB=runtime/modelops.db
MODEL_OPS_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
# Set a strong key before sharing the server beyond your own computer.
MODEL_OPS_API_KEY=
# Provider secrets are referenced by environment variable NAME in model settings.
MODEL_PROVIDER_API_KEY=
